# ──────────────────────────────────────────────────────────────────────────────
# News AI Agent — Environment Variables
# Copy this file to .env and fill in your values:  cp .env.example .env
# ──────────────────────────────────────────────────────────────────────────────

# AI API Key (required)
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Instagram Configuration (required)
INSTAGRAM_ACCESS_TOKEN=your_instagram_access_token_here
INSTAGRAM_ACCOUNT_ID=your_instagram_account_id_here

# Twitter/X Configuration (optional — not used by default)
# TWITTER_API_KEY=your_twitter_api_key_here
# TWITTER_API_SECRET=your_twitter_api_secret_here
# TWITTER_ACCESS_TOKEN=your_twitter_access_token_here
# TWITTER_ACCESS_TOKEN_SECRET=your_twitter_access_token_secret_here

# AWS Configuration (optional — only for Lambda deployment)
# AWS_ACCESS_KEY_ID=your_aws_access_key_here
# AWS_SECRET_ACCESS_KEY=your_aws_secret_key_here
# AWS_REGION=eu-central-1

# Video / Reels — ElevenLabs TTS (optional — falls back to free edge-tts)
# Sign up: https://elevenlabs.io  →  API Keys  →  create key with TTS permission
ELEVENLABS_API_KEY=your_elevenlabs_api_key_here
ELEVENLABS_VOICE_ID=onwK4e9ZLuTAKqWW03F9

# Video / Reels — Pexels stock footage (optional — falls back to article image)
# Sign up: https://www.pexels.com/api/  →  free API key
PEXELS_API_KEY=your_pexels_api_key_here

# Feature flag — daily "Did you know?" Dutch-fact Instagram Story (08:00 daily).
# When "false" (default) nothing is generated or published. Set "true" to enable.
ENABLE_INSTAGRAM_STORIES=false

# Connected Facebook Page ID — when set, the daily Story is also cross-posted as
# a Facebook Page Story. Requires the token to hold the pages_manage_posts scope.
# Leave empty to publish to Instagram only.
FACEBOOK_PAGE_ID=

# YouTube Shorts (optional — publishes news Reels as YouTube Shorts)
# Set up: Google Cloud Console → YouTube Data API v3 → OAuth 2.0 credentials
# Then run the OAuth flow locally to obtain the refresh token.
# If absent, youtube_worker skips publishing silently (no alert).
YOUTUBE_CLIENT_ID=your_google_oauth_client_id_here
YOUTUBE_CLIENT_SECRET=your_google_oauth_client_secret_here
YOUTUBE_REFRESH_TOKEN=your_youtube_refresh_token_here

# Error Alert Email (optional — sends email on Lambda errors like OOM, token expiry)
ALERT_EMAIL=your_email@example.com

# ── Observability (optional) ──────────────────────────────────────────────────

# LangSmith — LLM traces, token usage, latency dashboard
# Sign up: https://smith.langchain.com  →  Settings  →  API Keys
LANGCHAIN_TRACING_V2=true
LANGCHAIN_API_KEY=ls_...your_key_here
LANGCHAIN_PROJECT=news-ai-agent

# Langfuse — LLM traces, cost tracking, quality dashboard
# Sign up: https://cloud.langfuse.com  →  Settings  →  API Keys
LANGFUSE_PUBLIC_KEY=pk-lf-...your_key_here
LANGFUSE_SECRET_KEY=sk-lf-...your_key_here
# LANGFUSE_HOST=https://cloud.langfuse.com  # default, override for self-hosted
