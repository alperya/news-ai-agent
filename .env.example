# ──────────────────────────────────────────────────────────────────────────────
# News AI Agent — Environment Variables
# Copy this file to .env and fill in your values:  cp .env.example .env
# ──────────────────────────────────────────────────────────────────────────────

# AI API Key (required)
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# ── Claude model per role (optional — these are the defaults) ────────────────
# Every role is env-overridable, so a model change is a Secrets Manager edit,
# not a deploy. Priority order is quality first, price second.
#
# KEEP THESE TWO ON OPUS unless you have measured otherwise:
#   CONTENT_MODEL — batch selection is the editorial brain. It picks the story,
#     scores it on both ranking axes, and writes the post. This model IS the
#     product.
#   VISION_MODEL  — the footage gate that stops a Reel claiming the wrong
#     place. Model quality here prevents published mistakes (see the
#     Harlingen / Kansai / cosy-fireplace failures in CLAUDE.md).
#
# VISION_MODEL was split out of REVIEW_MODEL in 2026-08. Before the split all
# three secondary roles shared one variable, so lowering REVIEW_MODEL to save
# money on quality_check would silently have downgraded the footage gate too.
# CONTENT_MODEL=claude-opus-5
# VISION_MODEL=claude-opus-5
# REVIEW_MODEL=claude-sonnet-5
# FOOTAGE_QUERY_MODEL=claude-sonnet-5
# ANALYTICS_MODEL=claude-opus-5          # weekly, 1 call — negligible cost
# SELECTION_REVIEW_MODEL=claude-opus-5   # weekly, 1 call — negligible cost

# Instagram Configuration (required)
INSTAGRAM_ACCESS_TOKEN=your_instagram_access_token_here
INSTAGRAM_ACCOUNT_ID=your_instagram_account_id_here

# Twitter/X Configuration (optional — not used by default)
# TWITTER_API_KEY=your_twitter_api_key_here
# TWITTER_API_SECRET=your_twitter_api_secret_here
# TWITTER_ACCESS_TOKEN=your_twitter_access_token_here
# TWITTER_ACCESS_TOKEN_SECRET=your_twitter_access_token_secret_here

# AWS Configuration (optional — only for Lambda deployment)
# AWS_ACCESS_KEY_ID=your_aws_access_key_here
# AWS_SECRET_ACCESS_KEY=your_aws_secret_key_here
# AWS_REGION=eu-central-1

# Video / Reels — ElevenLabs TTS (optional — falls back to free edge-tts)
# Sign up: https://elevenlabs.io  →  API Keys  →  create key with TTS permission
ELEVENLABS_API_KEY=your_elevenlabs_api_key_here
ELEVENLABS_VOICE_ID=onwK4e9ZLuTAKqWW03F9

# Video / Reels — Pexels stock footage (optional — falls back to article image)
# Sign up: https://www.pexels.com/api/  →  free API key
PEXELS_API_KEY=your_pexels_api_key_here

# Feature flag — daily "Did you know?" Dutch-fact Instagram Story (08:00 daily).
# When "false" (default) nothing is generated or published. Set "true" to enable.
ENABLE_INSTAGRAM_STORIES=false

# Feature flag — weekly NL events post (Thursday). Deprecated for low engagement:
# when "false" (default) the weekly cron fires but the pipeline returns immediately
# without scraping/scoring/generating anything. Set "true" to re-enable.
ENABLE_EVENT_POSTS=false

# Feature flag — weekly Dutch-fact carousel feed post (Sunday 12:00 Amsterdam).
# Collects the week's Story facts into one save-friendly Instagram carousel.
# Enabled by default (code default "true"); set "false" to disable. Needs
# ENABLE_INSTAGRAM_STORIES on to have facts to collect.
ENABLE_FACT_CAROUSEL=true

# Publishing drought watchdog — the daily metrics collector checks Instagram for the
# newest post and emails an alert if it is older than this many hours. This is the
# catch-all failure detector: it verifies at the destination, so it notices a silently
# broken pipeline regardless of the cause. Normal cadence is 2 posts/day and the
# viral-skip guard only ever skips one slot, so the largest legitimate gap is ~17h.
PUBLISH_DROUGHT_HOURS=30

# Feature flag — viral-skip guard (news slots only). Before each news run the
# previous post's live engagement is checked; if it is younger than
# VIRAL_WINDOW_HOURS and has both >= VIRAL_SKIP_MULTIPLIER x the 30-day median
# engagement AND >= VIRAL_MIN_ENGAGEMENT, that one slot is skipped so the viral
# post keeps the audience and the top of the grid. Only one slot is ever skipped
# per viral post, and any API/data error means the post goes out normally.
# Enabled by default (code default "true"); set "false" to always post on schedule.
ENABLE_VIRAL_SKIP=true
VIRAL_SKIP_MULTIPLIER=5.0
VIRAL_MIN_ENGAGEMENT=1000
VIRAL_WINDOW_HOURS=24

# Rolling content-mix constraints, stated in the selection prompt (never a hard
# filter — a genuine national emergency must still be able to override them).
# CONTENT_MIX_WINDOW_DAYS — window the mix is measured over.
# VIOLENCE_SHARE_CAP      — max share of that window that may be crime/security.
# TOPIC_SHARE_CAP         — max share ANY single topic may hold. Added after the
#   crime cap alone let Weather reach 30% of output for a fortnight (a 13-post
#   drought serial) while median reach halved: a one-way cap is not a mix.
# SERIES_MAX_DAYS         — consecutive days one named series may run. Counted in
#   days, not posts: the account publishes twice daily and fatigue is felt in days.
CONTENT_MIX_WINDOW_DAYS=7
VIOLENCE_SHARE_CAP=0.40
TOPIC_SHARE_CAP=0.30
SERIES_MAX_DAYS=4

# Brand logo shown on the carousel's closing follow slide (optional). Path to a
# PNG (transparent background recommended). If unset, a "DUTCH DAILY" text
# wordmark is drawn instead. In Lambda, bundle the file in the ZIP and point here.
BRAND_LOGO_PATH=

# Connected Facebook Page ID — when set, the daily Story is also cross-posted as
# a Facebook Page Story. Requires the token to hold the pages_manage_posts scope.
# Leave empty to publish to Instagram only.
FACEBOOK_PAGE_ID=

# LinkedIn Company Page — cross-posts news Reels to the Company Page feed (event
# Reels and Stories are excluded). Gated by the ENABLE_LINKEDIN flag (default
# "false") AND credentials: nothing publishes until the flag is "true" even if the
# token/org are set, so the code can ship dark. The access token must hold the
# w_organization_social scope. LINKEDIN_ORG_ID is the numeric Company Page id
# (used to build urn:li:organization:<id>).
# Note: LinkedIn access tokens expire ~60 days — manual re-auth, like YouTube.
ENABLE_LINKEDIN=false
LINKEDIN_ACCESS_TOKEN=
LINKEDIN_ORG_ID=

# YouTube Shorts (optional — publishes news Reels as YouTube Shorts)
# Set up: Google Cloud Console → YouTube Data API v3 → OAuth 2.0 credentials
# Then run the OAuth flow locally to obtain the refresh token.
# If absent, youtube_worker skips publishing silently (no alert).
YOUTUBE_CLIENT_ID=your_google_oauth_client_id_here
YOUTUBE_CLIENT_SECRET=your_google_oauth_client_secret_here
YOUTUBE_REFRESH_TOKEN=your_youtube_refresh_token_here

# Error Alert Email (optional — sends email on Lambda errors like OOM, token expiry)
ALERT_EMAIL=your_email@example.com

# ── Observability (optional) ──────────────────────────────────────────────────

# LangSmith — LLM traces, token usage, latency dashboard
# Sign up: https://smith.langchain.com  →  Settings  →  API Keys
LANGCHAIN_TRACING_V2=true
LANGCHAIN_API_KEY=ls_...your_key_here
LANGCHAIN_PROJECT=news-ai-agent

# Langfuse — LLM traces, cost tracking, quality dashboard
# Sign up: https://cloud.langfuse.com  →  Settings  →  API Keys
LANGFUSE_PUBLIC_KEY=pk-lf-...your_key_here
LANGFUSE_SECRET_KEY=sk-lf-...your_key_here
# LANGFUSE_HOST=https://cloud.langfuse.com  # default, override for self-hosted

# ── Infrastructure wiring (optional — read by code, injected by Terraform) ───
# Documented here because they are read from the environment but were absent
# from this file, which made them invisible when running locally.
# SNS_ALERT_TOPIC_ARN=          # every email path no-ops when this is unset
# RESULTS_BUCKET=news-ai-agent-results-645949963620
# METRICS_TABLE=news-ai-agent-post-metrics
# REELS_PUBLISH_FUNCTION_NAME=news-ai-agent-reels-publisher
# FOOTAGE_REUSE_WINDOW_DAYS=30  # import-time constant, NOT hot-tunable
